{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ab-digital-leads",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "triggers": {"crons": ["*/5 * * * *"]},
  "d1_databases": [
    {"binding": "DB", "database_name": "ab-digital-leads", "database_id": "REPLACE_WITH_D1_DATABASE_ID"}
  ]
}
